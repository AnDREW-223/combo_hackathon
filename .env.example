# 複製為 .env 後再填入本機開發設定；不要把真正的金鑰提交到 Git。
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# 尚未和後端團隊確認 API 契約前，維持空白並使用假資料。
CUSTOMER_API_BASE_URL=
CUSTOMER_API_TOKEN=

# LINE 串接完成前不要填入正式頻道憑證。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# AI 供應商與模型待團隊確認；骨架目前使用可預期的假資料規則。
LLM_PROVIDER=stub
LLM_API_KEY=
