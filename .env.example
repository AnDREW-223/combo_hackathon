# 此檔案是設定範本。請複製成 .env，並只在本機 .env 填入真實金鑰；不要把金鑰填在此檔或提交到 Git。
# 請在 Google AI Studio 建立 Gemini API Key 後，貼在本機 .env 的等號右側。
# 多把金鑰請用逗號分隔，例如 GEMINI_API_KEYS=key1,key2；請勿提交真實金鑰。
GEMINI_API_KEYS=
# 舊設定相容欄位：若未設定 GEMINI_API_KEYS，程式仍會讀取 GEMINI_API_KEY。
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# rule_based：本機規則推論，不呼叫 Gemini；gemini：啟用生成與驗證兩階段呼叫。
AGENT_MODE=rule_based
APP_ENV=development
# 管理後台 Backend 位址。設定後，AI Agent 會從此 API 取得會員假資料。
BACKEND_BASE_URL=http://127.0.0.1:8100
# Backend 與 AI Agent 之間的內部驗證字串，請只填在本機 .env，勿提交 Git。
BACKEND_AGENT_SHARED_SECRET=

# 到 LINE Developers Console 的 Messaging API 頁面複製 Channel Secret，填入本機 .env 的 LINE_CHANNEL_SECRET= 後方。
LINE_CHANNEL_SECRET=
# 在同一個 Messaging API 頁面簽發 Channel access token，填入本機 .env 的 LINE_CHANNEL_ACCESS_TOKEN= 後方。
LINE_CHANNEL_ACCESS_TOKEN=
